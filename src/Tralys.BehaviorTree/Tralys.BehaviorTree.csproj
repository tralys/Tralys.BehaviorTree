<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Tralys.BehaviorTree</RootNamespace>
    <AssemblyName>Tralys.BehaviorTree</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Package identity -->
    <PackageId>Tralys.BehaviorTree</PackageId>
    <Authors>vrimar</Authors>
    <Company>vrimar</Company>
    <Description>Zero/low-allocation behavior tree library: one shared immutable tree per archetype, one compact NodeState[] per agent, 0 B per tick.</Description>
    <PackageTags>behaviour-tree;behavior-tree;ai;game-ai;bt;zero-allocation;gamedev</PackageTags>

    <!-- Repository / project URLs -->
    <PackageProjectUrl>https://github.com/tralys/Tralys.BehaviorTree</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tralys/Tralys.BehaviorTree.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- License, README & icon -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Ship XML docs so consumers get summaries in the IDE. CS1591 is off: the factory
         overloads are self-describing and documented on the node types they construct. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols + SourceLink -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>

    <!-- Pack only via CI release flow (dotnet pack), not on every build. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
